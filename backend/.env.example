# Backend Environment Variables Template
# Copy this file to .env.development for local development
# Set these variables in Railway dashboard for deployments

# Database Configuration (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Authentication (Use the secure JWT secret from SECURITY.md)
JWT_SECRET=CupTrack2024_SecureJWT_Authentication_Key_9X7mN4pQ2wR8vB3nM6kL1sA5dF9hJ2uY8tE4rW
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# Development: https://cuptrack-git-develop.vercel.app
# Production: https://cuptrack.vercel.app

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Monitoring and Analytics
SENTRY_DSN=
LOG_LEVEL=info