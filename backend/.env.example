# Backend Environment Variables Template
# Copy this file to .env.development for local development
# Set these variables in Railway dashboard for deployments

# Database Configuration (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Authentication
JWT_SECRET=your-random-jwt-secret-minimum-32-characters
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# Development: https://cuptrack-git-develop.vercel.app
# Production: https://cuptrack.vercel.app

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Monitoring and Analytics
SENTRY_DSN=
LOG_LEVEL=info