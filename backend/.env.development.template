# CupTrack Backend Development Environment
# Copy this file to .env.development and update with your actual Supabase credentials

# Database Configuration (Supabase Development Project)
SUPABASE_URL=https://your-dev-project-id.supabase.co
SUPABASE_ANON_KEY=your_development_anon_key_here
SUPABASE_SERVICE_KEY=your_development_service_key_here

# Authentication - Secure JWT Secret (Generated and saved in SECURITY.md)
JWT_SECRET=CupTrack2024_SecureJWT_Authentication_Key_9X7mN4pQ2wR8vB3nM6kL1sA5dF9hJ2uY8tE4rW
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (Update with your Vercel development URL)
CORS_ORIGIN=https://cuptrack-git-develop.vercel.app

# Security Settings
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Monitoring and Analytics
SENTRY_DSN=
LOG_LEVEL=info

