# Production Environment Configuration for Vercel Deployment
# CRITICAL: This fixes the API URL configuration issue
# Vercel frontend now connects to Railway backend instead of localhost

# API Configuration - Railway Backend Development URL  
REACT_APP_API_BASE_URL=https://cuptrack-backend-dev.up.railway.app/api/v1

# Environment
REACT_APP_ENV=production

# Note: This uses development Railway URL for now
# For actual production deployment, change to:
# REACT_APP_API_BASE_URL=https://cuptrack-backend-prod.up.railway.app/api/v1