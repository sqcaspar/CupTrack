# Frontend Environment Variables Template
# Copy this file to .env.development for local development
# IMPORTANT: Set these variables in Vercel dashboard for deployments

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3001/api/v1

# FOR VERCEL DEPLOYMENT - Set in Vercel Dashboard:
# Development: REACT_APP_API_BASE_URL=https://cuptrack-backend-dev.up.railway.app/api/v1
# Production: REACT_APP_API_BASE_URL=https://cuptrack-backend-prod.up.railway.app/api/v1

# CRITICAL: The deployed Vercel frontend MUST use Railway backend URL, not localhost

# Supabase Configuration
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# Environment
NODE_ENV=development
# Options: development, staging, production

# Optional: Analytics and Monitoring
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_SENTRY_DSN=